{
  "expo": {
    "name": "Pump Coach",
    "slug": "pump-coach",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pumpcoach",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAF9"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thebreastfeedingmama.pumpcoach",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Pump Coach uses notifications to remind you when it's time to pump.",
        "NSPhotoLibraryUsageDescription": "Used to set your profile photo.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAF9"
      },
      "package": "com.thebreastfeedingmama.pumpcoach",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7C5CFC"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to set your profile photo."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1076848134286-3snb3nrggk2qr6dharasvsuq3c9gg84r",
          "googleServicesFile": "./google-services.json"
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "expo-mail-composer"
    ],
    "updates": {
      "url": "https://u.expo.dev/5023baf9-6583-42a7-8cb9-835618966ff2",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": "1.0.0",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "https://abksqrvvwasaniqpyblv.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFia3NxcnZ2d2FzYW5pcXB5Ymx2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzcxMDg3MjcsImV4cCI6MjA5MjY4NDcyN30.xw3SFqlElawqz9EUpD7CDFmn2w4LUPDMlGe6-_-GlsY",
      "router": {},
      "eas": {
        "projectId": "5023baf9-6583-42a7-8cb9-835618966ff2"
      }
    }
  }
}
